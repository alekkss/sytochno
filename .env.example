# =============================================================================
# Sutochno Parser — переменные окружения
# =============================================================================
# Скопируйте этот файл в .env и заполните обязательные переменные:
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# -----------------------------------------------------------------------------

# URL страницы поиска sutochno.ru с нужными фильтрами
SUTOCHNO_SEARCH_URL=https://sutochno.ru/front/searchapp/search?guests_adults=2&occupied=2026-05-05;2026-05-06&term=%D0%A1%D0%B0%D0%BD%D0%BA%D1%82-%D0%9F%D0%B5%D1%82%D0%B5%D1%80%D0%B1%D1%83%D1%80%D0%B3&id=397367&type=city&SW.lat=59.77977557614511&SW.lng=30.026817069335937&NE.lat=60.055581373598486&NE.lng=30.582999930664045&price_per=1&is_studio=1&is_apartment=1

# -----------------------------------------------------------------------------
# НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (значения по умолчанию указаны после =)
# -----------------------------------------------------------------------------

# Запуск браузера без графического интерфейса (true/false)
# false — вы увидите окно браузера, true — браузер работает в фоне
HEADLESS_MODE=true

# Максимальное количество страниц для парсинга (0 = все доступные страницы)
MAX_PAGES=1

# Таймаут навигации в миллисекундах
NAVIGATION_TIMEOUT=60000

# Минимальная пауза между действиями в миллисекундах (защита от детекции бота)
MIN_DELAY_MS=2000

# Максимальная пауза между действиями в миллисекундах
MAX_DELAY_MS=5000

# -----------------------------------------------------------------------------
# ПАРАЛЛЕЛЬНЫЕ ВКЛАДКИ (ускорение обработки карточек)
# -----------------------------------------------------------------------------

# Количество параллельных вкладок в одном браузере
# Каждая вкладка обрабатывает свою карточку независимо
# При USE_PROXY=true — каждый прокси-браузер открывает MAX_TABS вкладок
# Пример: 10 прокси × 5 вкладок = до 50 карточек одновременно
# Рекомендуется 3–5 для стабильной работы
MAX_TABS=5

# Пауза между запуском вкладок в миллисекундах
# Распределяет нагрузку на сеть — вкладки стартуют не одновременно,
# а с интервалом TAB_DELAY_MS между ними
# Рекомендуется 2000–5000 мс
TAB_DELAY_MS=3000

# -----------------------------------------------------------------------------
# ХРАНИЛИЩЕ И ЭКСПОРТ
# -----------------------------------------------------------------------------

# Путь к базе данных SQLite
DB_PATH=data/sutochno_listings.db

# Путь к выходному Excel-файлу
EXPORT_PATH=data/sutochno_report.xlsx

# -----------------------------------------------------------------------------
# ЛОГИРОВАНИЕ
# -----------------------------------------------------------------------------

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Путь к файлу логов (пусто = только консоль)
LOG_FILE_PATH=logs/app.log

# -----------------------------------------------------------------------------
# ПРОКСИ (для параллельной обработки карточек)
# -----------------------------------------------------------------------------

# Использовать прокси для парсинга карточек (true/false)
# true — карточки обрабатываются параллельно через несколько прокси-браузеров
# false — обработка через один браузер (с параллельными вкладками, если MAX_TABS > 1)
USE_PROXY=true

# Путь к файлу со списком прокси
# Формат каждой строки: ip:port:login:password
# Пример: 194.28.193.202:11223:fwrBfkVyVw:Bw3BKDfzNp
PROXIES_PATH=data/proxies.txt

# Максимальное количество одновременных прокси-браузеров
# Если рабочих прокси больше этого числа — используются только первые N
# Каждый прокси-браузер открывает MAX_TABS вкладок
# Рекомендуется 3–7 для стабильной работы
MAX_PROXY_WORKERS=5


# это брать
MEMORY_LIMIT_MB=0

BLACKLIST_THRESHOLD=2

# Адаптивный контроль параллелизма (AIMD)
# Минимальное количество одновременных операций (по умолчанию: 5)
# Ниже этого значения лимит не опустится даже при 100% ошибок.
CONCURRENCY_MIN=5

# Максимальное количество одновременных операций (по умолчанию: 0 = авто)
# 0 = автоматически (прокси × вкладки). Рекомендуется не более 100.
CONCURRENCY_MAX=0

# Стартовое количество одновременных операций (по умолчанию: 0 = авто)
# 0 = автоматически (половина от максимума). Безопасный рампинг.
CONCURRENCY_START=0

# Таймаут обработки одной карточки в секундах (все попытки суммарно).
# Если карточка не обогатилась за это время — обработка прерывается,
# карточка попадает в retry-раунды. 0 = без ограничения.
# Рекомендуется 240 (4 минуты).
ENRICH_TIMEOUT_SECONDS=240


# -----------------------------------------------------------------------------
# КАЛЕНДАРЬ ЗАНЯТОСТИ (точное разделение «продан / техблок»)
# -----------------------------------------------------------------------------
# Фича уточняет календарь busy-объектов через эндпоинт
# orders/getOrdersByObject (список занятых периодов: брони и блокировки
# владельца). После скользящего окна каждый busy-объект переклассифицируется:
#   дата входит в занятый период  → 1 (продан)
#   остальные дни группируются в островки между заказами:
#     островок с доступным заездом (unbusy от окна) → весь 0 (свободен:
#       ночи продаются бронью с более ранним заездом)
#     островок без единого доступного заезда (короче min-stay) → весь 2
#       (техблок — непродаваемые ночи)
# Дни 0/1/2 пишутся в calendar_60_days; у дней 0 и 2 цена сохраняется
# (не обнуляется). При сбое запроса объекта календарь остаётся как
# определило окно (тихая деградация).


# Режим работы фичи:
#   all  — запросы для всех busy-объектов (полный охват; ~18 тыс.
#          GET-запросов за прогон, +10–15 минут при 20 прокси-воркерах)
#   list — только ID из EMPLOYMENT_CALENDAR_IDS (первый этап внедрения:
#          «мои объекты» и конкуренты, десятки запросов, нулевая нагрузка)
#   off  — фича выключена, календарь определяется только окном (откат)
EMPLOYMENT_CALENDAR_SCOPE=all

# Список ID объектов через запятую — используется только при
# EMPLOYMENT_CALENDAR_SCOPE=list. Требуется непустой список.
# Пример первого этапа внедрения (объект из плана приёмки):
#EMPLOYMENT_CALENDAR_IDS=923051
EMPLOYMENT_CALENDAR_IDS=

# Пауза между GET-запросами занятости в секундах (защита от rate-limit).
# Рекомендуется 0.3–0.5.
EMPLOYMENT_CALENDAR_PAUSE=0.3